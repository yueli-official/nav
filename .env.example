# Nav complete standalone topology.
# Copy to .env, generate every blank secret, then run:
#   docker compose config --quiet
#   docker compose up -d --wait

NAV_POSTGRES_USER=nav
NAV_POSTGRES_PASSWORD=
NAV_POSTGRES_DB=nav
NAV_DATABASE_URL=postgres://nav:${NAV_POSTGRES_PASSWORD}@nav-postgres:5432/nav?sslmode=disable
NAV_API_PORT=8090
NAV_WEB_PORT=3006
NAV_SITE_KEY=nav-yueli
NAV_SITE_BRAND=月离导航
NAV_WEB_SEAL_SECRET=
NAV_COOKIE_SECURE=false

# Initial standalone administrator.
NAV_ADMIN_SUB=
NAV_ADMIN_EMAIL=
NAV_ADMIN_PASSWORD=
NAV_ADMIN_DISPLAY_NAME=Nav Administrator
NAV_BOOTSTRAP_ADMIN_SUBS=["${NAV_ADMIN_SUB}"]

# Managed Identity binding. The browser-facing issuer is separate from the
# TLS-protected container URLs used for discovery and key retrieval.
IDENTITY_POSTGRES_USER=identity
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_POSTGRES_DB=identity
IDENTITY_DATABASE_URL=postgres://identity:${IDENTITY_POSTGRES_PASSWORD}@identity-postgres:5432/identity?sslmode=disable
IDENTITY_GLOBAL_SECRET=
IDENTITY_PORT=8081
IDENTITY_ACCOUNT_PORT=3000
IDENTITY_COOKIE_SECURE=false
IDENTITY_WEBAUTHN_RPID=localhost
IDENTITY_WEBAUTHN_ORIGINS=["http://localhost:3000"]
IDENTITY_ALLOW_PRIVATE_HTTP_REDIRECTS=false
NAV_IDENTITY_ISSUER=http://localhost:8081
NAV_IDENTITY_INTERNAL_URL=http://identity:8081
NAV_IDENTITY_DISCOVERY_URL=https://identity-internal:8443/.well-known/openid-configuration
NAV_IDENTITY_JWKS_URL=https://identity-internal:8443/oauth2/jwks.json
NAV_ACCOUNT_ORIGIN=http://localhost:3000
NAV_OIDC_CLIENT_ID=nav-yueli-web
NAV_OIDC_REDIRECT_URI=http://localhost:3006/auth/callback
NAV_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3006/
NAV_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false
NAV_ALLOW_LOOPBACK_IDENTITY_HTTP=false

NAV_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

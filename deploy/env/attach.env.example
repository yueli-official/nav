# Attach topology: Nav owns its API, Web, PostgreSQL and migrations. Identity
# must already be provisioned with this browser client and be reachable.
NAV_POSTGRES_USER=nav
NAV_POSTGRES_PASSWORD=
NAV_POSTGRES_DB=nav
NAV_DATABASE_URL=postgres://nav:${NAV_POSTGRES_PASSWORD}@nav-postgres:5432/nav?sslmode=disable
NAV_BOOTSTRAP_ADMIN_SUBS=[]

NAV_IDENTITY_ISSUER=https://identity.example.com
NAV_IDENTITY_INTERNAL_URL=https://identity.example.com
NAV_IDENTITY_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
NAV_IDENTITY_JWKS_URL=https://identity.example.com/oauth2/jwks.json
NAV_ACCOUNT_ORIGIN=https://account.example.com
NAV_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false
NAV_ALLOW_LOOPBACK_IDENTITY_HTTP=false

NAV_SITE_KEY=nav-yueli
NAV_SITE_BRAND=月离导航
NAV_API_PORT=8090
NAV_WEB_PORT=3006
NAV_WEB_SEAL_SECRET=
NAV_COOKIE_SECURE=true
NAV_OIDC_CLIENT_ID=nav-yueli-web
NAV_OIDC_REDIRECT_URI=https://nav.example.com/auth/callback
NAV_OIDC_POST_LOGOUT_REDIRECT_URI=https://nav.example.com/
NAV_ENVIRONMENT=production
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
